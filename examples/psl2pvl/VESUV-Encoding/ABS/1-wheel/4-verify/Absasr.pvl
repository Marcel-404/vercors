class Absasr {
    Main m;
    seq<int> v;
    int temp_fv;
    seq<int> s;
    seq<int> a;
    int fa;
    seq<int> lambda;
    seq<int> p;
    int fv;
    
    
    ensures Perm(this.m, write);
    ensures this.m == m_param;
    ensures Perm(this.v, write);
    ensures |this.v| == 1;
    ensures Perm(this.temp_fv, write);
    ensures Perm(this.s, write);
    ensures |this.s| == 1;
    ensures Perm(this.a, write);
    ensures |this.a| == 1;
    ensures Perm(this.fa, write);
    ensures Perm(this.lambda, write);
    ensures |this.lambda| == 1;
    ensures Perm(this.p, write);
    ensures |this.p| == 1;
    ensures Perm(this.fv, write);
    constructor(
        Main m_param
    ) {
        this.m = m_param;
        this.lambda = [0];
        this.p = [0];
        this.a = [0];
        this.v = [0];
        this.s = [0];
    }
    
    
    requires Perm(this.m, read);
    requires this.m != null;
    requires committed(this.m);
    requires held(this.m);
    requires this.m.global_invariant();
    requires this.m.ecu_absasr_absasr == this;
    ensures Perm(this.m, read);
    ensures this.m != null;
    ensures committed(this.m);
    ensures held(this.m);
    ensures this.m.global_invariant();
    ensures this.m.ecu_absasr_absasr == this;
    // The measured values are not changed by the ABS
    ensures v == \old(v) ** a == \old(a) ** fv == \old(fv) ** fa == \old(fa);
    // If the speed is not high enough for the ABS to activate, nothing will be changed
    ensures (fv <= 22 ==> (lambda == \old(lambda) && p == \old(p) && s == \old(s)));
    // If the ABS activates, it calculates the correct slippage for each wheel
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; {: lambda[z] :} == ((fv - v[z]) * 100) / fv));
    // The ABS implementation represents a state machine with 8 states and given transitions.
    // STATE 1 -> STATE 2 if wheel deceleration is too strong, braking pressure constant
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 1 && a[z] < -14) ==> {: p[z] :} == 0)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 1 && a[z] < -14) ==> {: s[z] :} == 2)));
    // STATE 2 -> STATE 3 if slippage is too high, braking pressure decreasing
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 2 && lambda[z] > 13) ==> {: p[z] :} == -1)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 2 && lambda[z] > 13) ==> {: s[z] :} == 3)));
    // STATE 3 -> STATE 4 if deceleration has stabilized, braking pressure constant
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 3 && a[z] > -14) ==> {: p[z] :} == 0)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 3 && a[z] > -14) ==> {: s[z] :} == 4)));
    // STATE 4 -> STATE 5 if wheel acceleration is too high, braking pressure increasing
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 4 && a[z] > 98) ==> {: p[z] :} == 2)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 4 && a[z] > 98) ==> {: s[z] :} == 5)));
    // STATE 5 -> STATE 6 if wheel acceleration has stabilized, braking pressure constant
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 5 && a[z] < 98) ==> {: p[z] :} == 0)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 5 && a[z] < 98) ==> {: s[z] :} == 6)));
    // STATE 6 -> STATE 7 if wheel acceleration is near zero, braking pressure gradually increasing
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 6 && a[z] < 2) ==> {: p[z] :} == 1)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 6 && a[z] < 2) ==> {: s[z] :} == 7)));
    // STATE 7 -> STATE 8 if wheel deceleration is too strong again, braking pressure decreasing
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 7 && a[z] < -14) ==> {: p[z] :} == -1)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 7 && a[z] < -14) ==> {: s[z] :} == 8)));
    // STATE 8 -> STATE 4 if wheel deceleration has stabilized, braking pressure constant
    ensures (fv > 22 ==> (\forall int z = 0 .. |p|; ((\old(s[z]) == 8 && a[z] > -14) ==> {: p[z] :} == 0)));
    ensures (fv > 22 ==> (\forall int z = 0 .. |s|; ((\old(s[z]) == 8 && a[z] > -14) ==> {: s[z] :} == 4)));
    void _abs() {
        if (this.fv > 22) {
            int i;
            loop_invariant Perm(this.m, read);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant this.m.global_invariant();
            loop_invariant this.m.ecu_absasr_absasr == this;
            loop_invariant this.fv > 22;
            loop_invariant (0 <= i && i <= 1);
            loop_invariant v == \old(v) ** a == \old(a) ** fv == \old(fv) ** fa == \old(fa)
                        ** (\forall int z = 0 .. i; {: lambda[z] :} == ((fv - v[z]) * 100) / fv)
                        ** (\forall int z = i .. |s|; {: s[z] :} == \old(s[z]))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 1 && a[z] < -14) ==> {: p[z] :} == 0))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 1 && a[z] < -14) ==> {: s[z] :} == 2))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 2 && lambda[z] > 13) ==> {: p[z] :} == -1))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 2 && lambda[z] > 13) ==> {: s[z] :} == 3))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 3 && a[z] > -14) ==> {: p[z] :} == 0))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 3 && a[z] > -14) ==> {: s[z] :} == 4))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 4 && a[z] > 98) ==> {: p[z] :} == 2))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 4 && a[z] > 98) ==> {: s[z] :} == 5))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 5 && a[z] < 98) ==> {: p[z] :} == 0))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 5 && a[z] < 98) ==> {: s[z] :} == 6))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 6 && a[z] < 2) ==> {: p[z] :} == 1))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 6 && a[z] < 2) ==> {: s[z] :} == 7))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 7 && a[z] < -14) ==> {: p[z] :} == -1))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 7 && a[z] < -14) ==> {: s[z] :} == 8))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 8 && a[z] > -14) ==> {: p[z] :} == 0))
                        ** (\forall int z = 0 .. i; ((\old(s[z]) == 8 && a[z] > -14) ==> {: s[z] :} == 4));
            for (i = 0; i < 1; i = i + 1) {
                this.lambda = this.lambda.update(i, (this.fv - this.v[i]) * 100 / this.fv);
                if (this.s[i] == 2) {
                    if (this.lambda[i] > 13) {
                        this.p = this.p.update(i, -1);
                        this.s = this.s.update(i, 3);
                    }
                } else if (this.s[i] == 6) {
                    if (this.a[i] < 2) {
                        this.p = this.p.update(i, 1);
                        this.s = this.s.update(i, 7);
                    }
                } else if (this.s[i] == 1) {
                    if (this.a[i] < -14) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 2);
                    }
                } else if (this.s[i] == 7) {
                    if (this.a[i] < -14) {
                        this.p = this.p.update(i, -1);
                        this.s = this.s.update(i, 8);
                    }
                } else if (this.s[i] == 4) {
                    if (this.a[i] > 98) {
                        this.p = this.p.update(i, 2);
                        this.s = this.s.update(i, 5);
                    }
                } else if (this.s[i] == 8) {
                    if (this.a[i] > -14) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 4);
                    }
                } else if (this.s[i] == 3) {
                    if (this.a[i] > -14) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 4);
                    }
                } else if (this.s[i] == 5) {
                    if (this.a[i] < 98) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 6);
                    }
                }
            }
        }
    }
    
    
    requires Perm(this.m, read);
    requires this.m != null;
    requires committed(this.m);
    requires held(this.m);
    requires this.m.global_invariant();
    requires this.m.ecu_absasr_absasr == this;
    ensures Perm(this.m, read);
    ensures this.m != null;
    ensures committed(this.m);
    ensures held(this.m);
    ensures this.m.global_invariant();
    ensures this.m.ecu_absasr_absasr == this;
    // The measured values are not changed by the ASR
    ensures v == \old(v) ** a == \old(a) ** fv == \old(fv) ** fa == \old(fa) ** s == \old(s);
    // If there is no slippage, then the ASR should release the braking pressure
    ensures (\forall int z = 0 .. 1; ((v[z] > 0 && (v[z] - v[0]) * 100 / v[z] <= 13) ==> {: p[z] :} < 0));
    // If there is slippage, but the wheel is not accelerating, braking pressure should be maintained
    ensures (\forall int z = 0 .. 1; ((v[z] > 0 && (v[z] - v[0]) * 100 / v[z] > 13 && a[z] <= 0) ==> {: p[z] :} == 0));
    // If there is slippage and the wheel continues to accelerate, braking pressure should be increased
    ensures (\forall int z = 0 .. 1; ((v[z] > 0 && (v[z] - v[0]) * 100 / v[z] > 13 && a[z] > 0) ==> {: p[z] :} > 0));
    void _asr() {
        int i;
        int j = 0;
        loop_invariant Perm(this.m, read);
        loop_invariant this.m != null;
        loop_invariant committed(this.m);
        loop_invariant held(this.m);
        loop_invariant this.m.global_invariant();
        loop_invariant this.m.ecu_absasr_absasr == this;
        loop_invariant (0 <= i && i <= 1);
        loop_invariant j == 0;
        loop_invariant v == \old(v) ** a == \old(a) ** fv == \old(fv) ** fa == \old(fa) ** s == \old(s);
        loop_invariant (\forall int z = 0 .. i; ((v[z] > 0 && (v[z] - v[0]) * 100 / v[z] <= 13) ==> {: p[z] :} < 0));
        loop_invariant (\forall int z = 0 .. i; ((v[z] > 0 && (v[z] - v[0]) * 100 / v[z] > 13 && a[z] <= 0) ==> {: p[z] :} == 0));
        loop_invariant (\forall int z = 0 .. i; ((v[z] > 0 && (v[z] - v[0]) * 100 / v[z] > 13 && a[z] > 0) ==> {: p[z] :} > 0));
        for (i = 0; i < 1; i = i + 1) {
            if (this.v[i] > 0) {
                this.lambda = this.lambda.update(i, (this.v[i] - this.v[j]) * 100 / this.v[i]);
                if (this.lambda[i] > 13) {
                    if (this.a[i] > 0) {
                        this.p = this.p.update(i, 2);
                    } else {
                        this.p = this.p.update(i, 0);
                    }
                } else {
                    this.p = this.p.update(i, -1);
                }
            }
            j = 0;
        }
    }
    
    
    ensures    ((val >= 0) ==> (\result == val))
            && ((val < 0) ==> (\result == -val));
    pure int abs(int val);
}
