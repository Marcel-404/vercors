
class Absasr_read_vr {
    Main m;
    
    boolean absasr_read_vr_init;
    
    int tmp_0_read_vr;
    
    ensures Perm(this.m, write);
    ensures this.m == m_param;
    ensures Perm(this.absasr_read_vr_init, write);
    ensures Perm(this.tmp_0_read_vr, write);
    ensures idle(this);
    constructor(
        Main m_param
    ) {
        this.m = m_param;
    }
    
    requires Perm(this.m, 1 \ 2);
    requires this.m != null;
    requires committed(this.m);
    requires Perm(this.m.ecu_absasr_absasr_read_vr, read);
    requires this.m.ecu_absasr_absasr_read_vr == this;
    ensures Perm(this.m, 1 \ 2);
    ensures this.m != null;
    ensures committed(this.m);
    ensures Perm(this.m.ecu_absasr_absasr_read_vr, read);
    ensures this.m.ecu_absasr_absasr_read_vr == this;
    run {
        lock this.m;
        this.tmp_0_read_vr = 0;
        loop_invariant Perm(this.m, 1 \ 2);
        loop_invariant this.m != null;
        loop_invariant committed(this.m);
        loop_invariant held(this.m);
        loop_invariant Perm(this.m.global_invariant(), 1);
        loop_invariant this.m.ecu_absasr_absasr_read_vr == this;
        while (true) {
            loop_invariant Perm(this.m, 1 \ 2);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant Perm(this.m.global_invariant(), 1);
            loop_invariant this.m.ecu_absasr_absasr_read_vr == this;
            while (|this.m.sc_fifo_int_speed_vr.buffer| <= this.m.sc_fifo_int_speed_vr.num_read) {
                this.m.process_state = this.m.process_state.update(5, 3);
                loop_invariant Perm(this.m, 1 \ 2);
                loop_invariant this.m != null;
                loop_invariant committed(this.m);
                loop_invariant held(this.m);
                loop_invariant Perm(this.m.global_invariant(), 1);
                loop_invariant this.m.ecu_absasr_absasr_read_vr == this;
                while (this.m.process_state[5] != -1 || this.m.event_state[3] != -2) {
                    unlock this.m;
                    lock this.m;
                }
            }
            this.m.ecu_absasr_absasr.v[0] = this.m.sc_fifo_int_speed_vr.fifo_read();
            this.m.ecu_absasr_absasr.a[0] = this.m.ecu_absasr_absasr.v[0] - this.tmp_0_read_vr;
            this.tmp_0_read_vr = this.m.ecu_absasr_absasr.v[0];
        }
        unlock this.m;
    }
}