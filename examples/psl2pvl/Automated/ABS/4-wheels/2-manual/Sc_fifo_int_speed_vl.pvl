    ensures this.num_read == \old(this.num_read) + 1;
    ensures this.m.primitive_channel_update == \old(this.m.primitive_channel_update).update(0, true);
    int fifo_read();
    
    requires Perm(this.m, read);
    requires this.m != null;
    requires held(this.m);
    requires this.m.update_permission_invariant();
    requires this.m.parameter_invariant();
    requires this.m.sc_fifo_int_speed_vl_permission_invariant();
    requires this.m.sc_fifo_int_speed_vl == this;
    requires |this.buffer| + |this.written| < this.m.buffer_size;
    ensures Perm(this.m, read);
    ensures this.m != null;
    ensures held(this.m);
    ensures this.m.update_permission_invariant();
    ensures this.m.parameter_invariant();
    ensures this.m.sc_fifo_int_speed_vl_permission_invariant();
