
class Absasr_read_vl {
    Main m;
    
    boolean absasr_read_vl_init;
    
    int tmp_1_read_vl;
    
    ensures Perm(this.m, write);
    ensures this.m == m_param;
    ensures Perm(this.absasr_read_vl_init, write);
    ensures Perm(this.tmp_1_read_vl, write);
    ensures idle(this);
    constructor(
        Main m_param
    ) {
        this.m = m_param;
    }
    
    requires Perm(this.m, 1 \ 2);
    requires this.m != null;
    requires committed(this.m);
    requires Perm(this.m.ecu_absasr_absasr_read_vl, read);
    requires this.m.ecu_absasr_absasr_read_vl == this;
    ensures Perm(this.m, 1 \ 2);
    ensures this.m != null;
    ensures committed(this.m);
    ensures Perm(this.m.ecu_absasr_absasr_read_vl, read);
    ensures this.m.ecu_absasr_absasr_read_vl == this;
    run {
        lock this.m;
        this.tmp_1_read_vl = 0;
        loop_invariant Perm(this.m, 1 \ 2);
        loop_invariant this.m != null;
        loop_invariant committed(this.m);
        loop_invariant held(this.m);
        loop_invariant this.m.global_invariant();
        loop_invariant this.m.ecu_absasr_absasr_read_vl == this;
        while (true) {
            loop_invariant Perm(this.m, 1 \ 2);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant this.m.global_invariant();
            loop_invariant this.m.ecu_absasr_absasr_read_vl == this;
            while (|this.m.sc_fifo_int_speed_vl.buffer| <= this.m.sc_fifo_int_speed_vl.num_read) {
                this.m.process_state = this.m.process_state.update(6, 1);
                loop_invariant Perm(this.m, 1 \ 2);
                loop_invariant this.m != null;
                loop_invariant committed(this.m);
                loop_invariant held(this.m);
                loop_invariant this.m.global_invariant();
                loop_invariant this.m.ecu_absasr_absasr_read_vl == this;
                while (this.m.process_state[6] != -1 || this.m.event_state[1] != -2) {
                    unlock this.m;
                    lock this.m;
                }
            }
            this.m.ecu_absasr_absasr.v = this.m.ecu_absasr_absasr.v.update(1, this.m.sc_fifo_int_speed_vl.fifo_read());
            this.m.ecu_absasr_absasr.a = this.m.ecu_absasr_absasr.a.update(1, this.m.ecu_absasr_absasr.v[1] - this.tmp_1_read_vl);
            this.tmp_1_read_vl = this.m.ecu_absasr_absasr.v[1];

            // Reset Timer
            this.m.timer_value = this.m.timer_value.update(1, this.m.event_state[14]);
            this.m.timer_reset = this.m.timer_reset.update(1, false);
            this.m.event_state = this.m.event_state.update(14, -3);

        }
        unlock this.m;
    }
}