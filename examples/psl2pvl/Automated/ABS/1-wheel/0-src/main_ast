SC_MODULE ( TickCounter ) {

  sc_fifo_out<int> out;
  int ticks;

  void send(){
    int speed;

    srand(time(NULL));
    while(true){
      wait(1, SC_MS);
      speed = rand();
      out.write(speed);
    }
  }
  SC_CTOR(TickCounter) {
    SC_THREAD(send);
  }
};

