class Tickcounter_vl_send {
    Main m;
    int ticks;
    int speed_send;
    
    
    ensures Perm(this.m, write);
    ensures this.m == m_param;
    ensures Perm(this.ticks, write);
    ensures Perm(this.speed_send, write);
    ensures idle(this);
    constructor(
        Main m_param
    ) {
        this.m = m_param;
    }
    
    
    requires Perm(this.m, 1 \ 2);
    requires this.m != null;
    requires committed(this.m);
    requires Perm(this.m.vl_tickcounter_vl_send, read);
    requires this.m.vl_tickcounter_vl_send == this;
    ensures Perm(this.m, 1 \ 2);
    ensures this.m != null;
    ensures committed(this.m);
    ensures Perm(this.m.vl_tickcounter_vl_send, read);
    ensures this.m.vl_tickcounter_vl_send == this;
    run {
        lock this.m;
        loop_invariant Perm(this.m, 1 \ 2);
        loop_invariant this.m != null;
        loop_invariant committed(this.m);
        loop_invariant held(this.m);
        loop_invariant this.m.global_invariant();
        loop_invariant this.m.vl_tickcounter_vl_send == this;
        while (true) {
            this.m.process_state = this.m.process_state.update(0, 8);
            this.m.event_state = this.m.event_state.update(8, 1);
            loop_invariant Perm(this.m, 1 \ 2);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant this.m.global_invariant();
            loop_invariant this.m.vl_tickcounter_vl_send == this;
            while (this.m.process_state[0] != -1 || this.m.event_state[8] != -2) {
                unlock this.m;
                lock this.m;
            }
            this.speed_send = this.generate__random__0();
            loop_invariant Perm(this.m, 1 \ 2);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant this.m.global_invariant();
            loop_invariant this.m.vl_tickcounter_vl_send == this;
            while (|this.m.sc_fifo_int_speed_vl.buffer| + |this.m.sc_fifo_int_speed_vl.written| >= this.m.buffer_size) {
                this.m.process_state = this.m.process_state.update(0, 0);
                loop_invariant Perm(this.m, 1 \ 2);
                loop_invariant this.m != null;
                loop_invariant committed(this.m);
                loop_invariant held(this.m);
                loop_invariant this.m.global_invariant();
                loop_invariant this.m.vl_tickcounter_vl_send == this;
                while (this.m.process_state[0] != -1 || this.m.event_state[0] != -2) {
                    unlock this.m;
                    lock this.m;
                }
            }
            this.m.sc_fifo_int_speed_vl.fifo_write(this.speed_send);
            if (this.m.event_state[14] == -3) {
                this.m.event_state = this.m.event_state.update(14, 1);
            }
        }
        unlock this.m;
    }
    
    
    pure int generate__random__0();
}
