class Absasr {
    Main m;
    seq<int> v;
    int temp_fv;
    seq<int> s;
    seq<int> a;
    int fa;
    seq<int> lambda;
    seq<int> p;
    int fv;
    int wheels;
    
    ensures Perm(this.m, write);
    ensures this.m == m_param;
    ensures Perm(this.v, write);
    ensures |this.v| == 1;
    ensures Perm(this.temp_fv, write);
    ensures Perm(this.s, write);
    ensures |this.s| == 1;
    ensures Perm(this.a, write);
    ensures |this.a| == 1;
    ensures Perm(this.fa, write);
    ensures Perm(this.lambda, write);
    ensures |this.lambda| == 1;
    ensures Perm(this.p, write);
    ensures |this.p| == 1;
    ensures Perm(this.fv, write);
    ensures Perm(this.wheels, read);
    ensures this.wheels == 1;
    constructor(
        Main m_param
    ) {
        this.m = m_param;
        this.lambda = [0];
        this.p = [0];
        this.a = [0];
        this.v = [0];
        this.s = [0];
        this.wheels = 1;
    }
    
    requires Perm(this.m, read);
    requires this.m != null;
    requires committed(this.m);
    requires held(this.m);
    requires this.m.global_invariant();
    requires this.m.ecu_absasr_absasr == this;
    ensures Perm(this.m, read);
    ensures this.m != null;
    ensures committed(this.m);
    ensures held(this.m);
    ensures this.m.global_invariant();
    ensures this.m.ecu_absasr_absasr == this;
    ensures (\old(v) == v && \old(a) == a && \old(fv) == fv && \old(fa) == fa); 
    ensures (\old(fv) <= 22 ==> (\old(lambda) == lambda && \old(p) == p && \old(s) == s));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; {: lambda[z] :} == ((fv - {: v[z] :}) * 100) / fv));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 1 && \old({: a[z] :})  < - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 2))));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 2 && lambda[z]  > 13) ==> ({: p[z] :} == -1 && {: s[z] :} == 3))));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 3 && \old({: a[z] :})  > - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 4))));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 4 && \old({: a[z] :})  > 98 ) ==>  ({: p[z] :} == 2 && {: s[z] :} == 5))));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 5 && \old({: a[z] :})  < 98 ) ==>  ({: p[z] :} == 0 && {: s[z] :} == 6))));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 6 && \old({: a[z] :})  < 2 ) ==>   ({: p[z] :} == 1 && {: s[z] :} == 7))));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 7 && \old({: a[z] :})  < - 14) ==> ({: p[z] :} == -1 && {: s[z] :} == 8))));
    ensures (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 8 && \old({: a[z] :})  > - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 4))));
    void _abs() {
        if (this.fv > 22) {
            int i;
            loop_invariant Perm(this.m, read);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant this.m.global_invariant();
            loop_invariant this.m.ecu_absasr_absasr == this;
            loop_invariant this.fv > 22;
            loop_invariant (0 <= i && i <= 1);
            loop_invariant (\old(v) == v && \old(a) == a && \old(fv) == fv && \old(fa) == fa);
            loop_invariant (\old(fv) <= 22 ==> (\old(lambda) == lambda && \old(p) == p && \old(s) == s));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; {: lambda[z] :} == ((fv - {: v[z] :}) * 100) / fv));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 1 && \old({: a[z] :}) < - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 2))));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 2 && lambda[z] > 13) ==> ({: p[z] :} == -1 && {: s[z] :} == 3))));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 3 && \old({: a[z] :}) > - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 4))));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 4 && \old({: a[z] :}) > 98 ) ==> ({: p[z] :} == 2 && {: s[z] :} == 5))));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 5 && \old({: a[z] :}) < 98 ) ==> ({: p[z] :} == 0 && {: s[z] :} == 6))));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 6 && \old({: a[z] :}) < 2 ) ==> ({: p[z] :} == 1 && {: s[z] :} == 7))));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 7 && \old({: a[z] :}) < - 14) ==> ({: p[z] :} == -1 && {: s[z] :} == 8))));
            loop_invariant (\old(fv) > 22 ==> (\forall int z = 0 .. i; ((\old({: s[z] :}) == 8 && \old({: a[z] :}) > - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 4))));
            loop_invariant (\forall int z = i .. wheels-1+1; {: s[z] :} == \old({: s[z] :})); // Won't verify without this
            for (i = 0; i < 1; i = i + 1) {
                this.lambda = this.lambda.update(i, (this.fv - this.v[i]) * 100 / this.fv);
                if (this.s[i] == 2) {
                    if (this.lambda[i] > 13) {
                        this.p = this.p.update(i, -1);
                        this.s = this.s.update(i, 3);
                    }
                } else if (this.s[i] == 6) {
                    if (this.a[i] < 2) {
                        this.p = this.p.update(i, 1);
                        this.s = this.s.update(i, 7);
                    }
                } else if (this.s[i] == 1) {
                    if (this.a[i] < -14) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 2);
                    }
                } else if (this.s[i] == 7) {
                    if (this.a[i] < -14) {
                        this.p = this.p.update(i, -1);
                        this.s = this.s.update(i, 8);
                    }
                } else if (this.s[i] == 4) {
                    if (this.a[i] > 98) {
                        this.p = this.p.update(i, 2);
                        this.s = this.s.update(i, 5);
                    }
                } else if (this.s[i] == 8) {
                    if (this.a[i] > -14) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 4);
                    }
                } else if (this.s[i] == 3) {
                    if (this.a[i] > -14) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 4);
                    }
                } else if (this.s[i] == 5) {
                    if (this.a[i] < 98) {
                        this.p = this.p.update(i, 0);
                        this.s = this.s.update(i, 6);
                    }
                }
            }
            /*assert (\old(v) == v && \old(a) == a && \old(fv) == fv && \old(fa) == fa); 
            assert (\old(fv) <= 22 ==> (\old(lambda) == lambda && \old(p) == p && \old(s) == s));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; {: lambda[z] :} == ((fv - {: v[z] :}) * 100) / fv));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 1 && \old({: a[z] :})  < - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 2))));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 2 && lambda[z]  > 13) ==> ({: p[z] :} == -1 && {: s[z] :} == 3))));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 3 && \old({: a[z] :})  > - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 4))));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 4 && \old({: a[z] :})  > 98 ) ==>  ({: p[z] :} == 2 && {: s[z] :} == 5))));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 5 && \old({: a[z] :})  < 98 ) ==>  ({: p[z] :} == 0 && {: s[z] :} == 6))));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 6 && \old({: a[z] :})  < 2 ) ==>   ({: p[z] :} == 1 && {: s[z] :} == 7))));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 7 && \old({: a[z] :})  < - 14) ==> ({: p[z] :} == -1 && {: s[z] :} == 8))));
            assert (\old(fv) > 22 ==> (\forall int z = 0 .. wheels-1+1; (( \old({: s[z] :})  == 8 && \old({: a[z] :})  > - 14) ==> ({: p[z] :} == 0 && {: s[z] :} == 4))));
        */
        }
    }
    
    requires Perm(this.m, read);
    requires this.m != null;
    requires committed(this.m);
    requires held(this.m);
    requires this.m.global_invariant();
    requires this.m.ecu_absasr_absasr == this;
    ensures Perm(this.m, read);
    ensures this.m != null;
    ensures committed(this.m);
    ensures held(this.m);
    ensures this.m.global_invariant();
    ensures this.m.ecu_absasr_absasr == this;
    ensures \old(this.v) == this.v && \old(this.a) == this.a &&\old(this.fv) == this.fv && \old(this.fa) == this.fa && \old(s) == this.s;
    ensures (\forall int z = 0 .. wheels-1+1; ((\old({: v[z] :}) > 0 && (\old({: v[z] :}) - \old(v[wheels - z - 1])) * 100 / \old({: v[z] :}) <= 13) ==> {: p[z] :} < 0));
    ensures (\forall int z = 0 .. wheels-1+1; ((\old({: v[z] :}) > 0 && (\old({: v[z] :}) - \old(v[wheels - z - 1])) * 100 / \old({: v[z] :})  > 13 && \old({: a[z] :}) <= 0) ==> {: p[z] :} == 0));
    ensures (\forall int z = 0 .. wheels-1+1; (\old({: v[z] :}) > 0 && (\old({: v[z] :})  - \old(v[wheels - z - 1])) * 100 / \old({: v[z] :})  > 13 && \old({: a[z] :}) > 0) ==> {: p[z] :} > 0);
    void _asr() {
        int i;
        int j = 0;
        loop_invariant Perm(this.m, read);
        loop_invariant this.m != null;
        loop_invariant committed(this.m);
        loop_invariant held(this.m);
        loop_invariant this.m.global_invariant();
        loop_invariant this.m.ecu_absasr_absasr == this;
        loop_invariant (0 <= i && i <= 1);
        loop_invariant j == 0;
        loop_invariant \old(this.v) == this.v && \old(this.a) == this.a && \old(this.fv) == this.fv && \old(this.fa) == this.fa && \old(s) == this.s;
        loop_invariant (\forall int z = 0 .. i; ((\old({: v[z] :}) > 0 && (\old({: v[z] :}) - \old(v[wheels - z - 1])) * 100 / \old({: v[z] :}) <= 13) ==> {: p[z] :} < 0));
        loop_invariant (\forall int z = 0 .. i; ((\old({: v[z] :}) > 0 && (\old({: v[z] :}) - \old(v[wheels - z - 1])) * 100 / \old({: v[z] :})  > 13 && \old({: a[z] :}) <= 0) ==> {: p[z] :} == 0));
        loop_invariant (\forall int z = 0 .. i; ((\old({: v[z] :}) > 0 && (\old({: v[z] :}) - \old(v[wheels - z - 1])) * 100 / \old({: v[z] :})  > 13 && \old({: a[z] :}) > 0) ==> {: p[z] :} > 0));
        for (i = 0; i < 1; i = i + 1) {
            if (this.v[i] > 0) {
                this.lambda = this.lambda.update(i, (this.v[i] - this.v[j]) * 100 / this.v[i]);
                if (this.lambda[i] > 13) {
                    if (this.a[i] > 0) {
                        this.p = this.p.update(i, 2);
                    } else {
                        this.p = this.p.update(i, 0);
                    }
                } else {
                    this.p = this.p.update(i, -1);
                }
            }
            j = 0;
        }
    }
}
