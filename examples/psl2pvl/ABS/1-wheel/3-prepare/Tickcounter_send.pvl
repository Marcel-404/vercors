class Tickcounter_send {
    Main m;
    int ticks;
    int speed_send;
    boolean at_send;
    boolean timer_set;
    boolean tickcounter_send_init;
    
    ensures Perm(this.m, write);
    ensures this.m == m_param;
    ensures Perm(this.ticks, write);
    ensures Perm(this.speed_send, write);
    ensures Perm(at_send, write) ** !at_send;
    ensures Perm(timer_set, write) ** !timer_set;
    ensures Perm(tickcounter_send_init, write) ** tickcounter_send_init;
    ensures idle(this);
    constructor(
        Main m_param
    ) {
        this.m = m_param;
        at_send = false;
        timer_set = false;
        tickcounter_send_init = true;
    }
    
    
    requires Perm(this.m, 1 \ 2);
    requires this.m != null;
    requires committed(this.m);
    requires Perm(this.m.s_tickcounter_send, read);
    requires this.m.s_tickcounter_send == this;
    requires Perm(at_send, 1\2) ** !at_send;
    requires Perm(timer_set, 1\2) ** !timer_set;
    requires Perm(tickcounter_send_init, 1\2) ** tickcounter_send_init;
    ensures Perm(this.m, 1 \ 2);
    ensures this.m != null;
    ensures committed(this.m);
    ensures Perm(this.m.s_tickcounter_send, read);
    ensures this.m.s_tickcounter_send == this;
    run {
        lock this.m;
        loop_invariant Perm(this.m, 1 \ 2);
        loop_invariant this.m != null;
        loop_invariant committed(this.m);
        loop_invariant held(this.m);
        loop_invariant this.m.global_invariant();
        loop_invariant this.m.s_tickcounter_send == this;
        loop_invariant Perm(tickcounter_send_init, 1\2);
        loop_invariant Perm(timer_set, 1\2);
        loop_invariant tickcounter_send_init != timer_set;
        loop_invariant Perm(at_send, 1\2) ** !at_send;
        while (true) {
            tickcounter_send_init = false; 
            this.m.process_state = this.m.process_state.update(0, 2);
            this.m.event_state = this.m.event_state.update(2, 1);
            at_send = true; 
            timer_set = false;    
            loop_invariant Perm(this.m, 1 \ 2);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant this.m.global_invariant();
            loop_invariant this.m.s_tickcounter_send == this;
            loop_invariant Perm(timer_set, 1\2) ** !timer_set;
            loop_invariant Perm(at_send, 1\2) ** at_send;
            loop_invariant Perm(tickcounter_send_init, 1\2) ** !tickcounter_send_init;
            while (this.m.process_state[0] != -1 || this.m.event_state[2] != -2) {
                unlock this.m;
                lock this.m;
            }
            at_send = false;        
            this.speed_send = this.generate__random__0();
                        
            loop_invariant Perm(this.m, 1 \ 2);
            loop_invariant this.m != null;
            loop_invariant committed(this.m);
            loop_invariant held(this.m);
            loop_invariant this.m.global_invariant();
            loop_invariant this.m.s_tickcounter_send == this;
            loop_invariant Perm(timer_set, 1\2) ** !timer_set;
            loop_invariant Perm(at_send, 1\2) ** !at_send;
            loop_invariant |this.m.sc_fifo_int.buffer| + |this.m.sc_fifo_int.written| == 0
                        ** this.m.event_state[2] == -2;
            loop_invariant Perm(tickcounter_send_init, 1\2) ** !tickcounter_send_init;
            while (|this.m.sc_fifo_int.buffer| + |this.m.sc_fifo_int.written| >= this.m.buffer_size) {
                this.m.process_state = this.m.process_state.update(0, 0);
                loop_invariant Perm(this.m, 1 \ 2);
                loop_invariant this.m != null;
                loop_invariant committed(this.m);
                loop_invariant held(this.m);
                loop_invariant this.m.global_invariant();
                loop_invariant this.m.s_tickcounter_send == this;
                loop_invariant Perm(timer_set, 1\2) ** !timer_set;
                loop_invariant Perm(at_send, 1\2) ** !at_send;
                loop_invariant Perm(tickcounter_send_init, 1\2) ** !tickcounter_send_init;
                while (this.m.process_state[0] != -1 || this.m.event_state[0] != -2) {
                    unlock this.m;
                    lock this.m;
                }
            }
            this.m.sc_fifo_int.fifo_write(this.speed_send);

            // Set timer
            this.m.event_state = this.m.event_state.update(4, 1);
            this.timer_set = true;
        }
        unlock this.m;
    }
    
    
    pure int generate__random__0();
}
